# Copy to .env for local development. Without MONGODB_URI, `npm run dev`
# starts an in-memory MongoDB and seeds demo data.

APP_ENV=development
PORT=3000
TZ=Asia/Colombo

# MongoDB Atlas connection string (database name in the path)
MONGODB_URI=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4200

# Optional: Redis for caching (e.g. Upstash rediss://...). In-memory cache if empty.
REDIS_URL=

# Optional: Firebase Realtime Database for live updates. SSE fallback if empty.
# Service account JSON (raw or base64) from Firebase console > Project settings > Service accounts
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_URL=
# Web app config JSON from Firebase console > Project settings > Your apps
FIREBASE_WEB_CONFIG=

# Optional: Notify.lk SMS gateway. SMS is logged only if empty.
NOTIFY_LK_USER_ID=
NOTIFY_LK_API_KEY=
NOTIFY_LK_SENDER_ID=

# Platform owner account created by `npm run seed`
SUPER_ADMIN_EMAIL=nuwanpriyamal@gmail.com
SUPER_ADMIN_PASSWORD=
